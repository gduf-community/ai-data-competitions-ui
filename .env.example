# Default preview cannot log in or forward business cookies.
WEB_RELEASE_MODE=public
API_ORIGIN=http://127.0.0.1:3001
# Runtime-only 32 random bytes encoded as 64 lowercase hex characters; same value on Web and API.
# Use a synthetic credential and synthetic API in preview/CI. Never use NEXT_PUBLIC_ or commit a real token.
API_SERVICE_TOKEN=
WEB_TRUSTED_ORIGIN=http://localhost:3000
# Production requires ingress to overwrite the selected header with exactly one IPv4/IPv6.
# Confirm header overwrite and private API source access in #106 before enabling trusted mode.
# WEB_CLIENT_IP_HEADER=x-real-ip
